# AreYouLowBattery - UDev rules for wireless mice, keyboards and headsets
# Delux / Attack Shark / Xenta / CompX / Beken devices (VID: 0x1d57)
KERNEL=="hidraw*", ATTRS{idVendor}=="1d57", MODE="0666", TAG+="uaccess"

# Actions Semiconductor Co., Ltd USB Audio & HID dongles (Baseus GH02, etc.) (VID: 0x10d6)
KERNEL=="hidraw*", ATTRS{idVendor}=="10d6", MODE="0666", TAG+="uaccess"

# SinoWealth generic gaming devices (VID: 0x258a)
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", MODE="0666", TAG+="uaccess"

# Telink semiconductor dongles (VID: 0x248a, 0x1915)
KERNEL=="hidraw*", ATTRS{idVendor}=="248a", MODE="0666", TAG+="uaccess"
