# AreYouLowBattery - UDev rules for wireless mice, keyboards and headsets
# Uses ACTION!="remove", SUBSYSTEM=="hidraw", MODE="0660", TAG+="uaccess"
# so systemd-logind grants dynamic ACL access exclusively to the active physical
# seat console user rather than global/world-writable permissions (0666).

# Delux / Attack Shark / Xenta / CompX / Beken devices (VID: 0x1d57)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"

# Areson / CompX 2.4G Dual Mode mice & keyboards (Ajazz, Attack Shark, Pulsar, Lamzu, VXE, Royalaxe) (VID: 0x25a7)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="25a7", MODE="0660", TAG+="uaccess"

# Royuan / RongYuan / Royalaxe / Akko / MonsGeek keyboards (VID: 0x3151)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3151", MODE="0660", TAG+="uaccess"

# Actions Semiconductor Co., Ltd USB Audio & HID dongles (Baseus GH02, etc.) (VID: 0x10d6)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="10d6", MODE="0660", TAG+="uaccess"

# SinoWealth generic gaming devices (VID: 0x258a)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", MODE="0660", TAG+="uaccess"

# Telink / Nordic Semiconductor dongles (VXE, ATK, Scyrox, Lamzu 4K) (VID: 0x248a, 0x1915, 0x3554)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="248a", MODE="0660", TAG+="uaccess"
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1915", MODE="0660", TAG+="uaccess"
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", MODE="0660", TAG+="uaccess"

